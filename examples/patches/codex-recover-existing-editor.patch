@@ -0,0 +1,34 @@
+import { expect, test } from "bun:test"
+import { applyUpdatePatch } from "../src/patch.ts"
+
+test("existing editor retains the function selector", () => {
+  expect(applyUpdatePatch("def first():\n    return 1\n\ndef second():\n    return 1\n",
+    "*** Update File: example.py\n@@ def second():\n-    return 1\n+    return 2\n"))
+    .toEqual({ ok: true, content: "def first():\n    return 1\n\ndef second():\n    return 2\n" })
+})
+
+test("existing editor retains the end-of-file selector", () => {
+  expect(applyUpdatePatch("value = 1\nseparator\nvalue = 1\n",
+    "*** Update File: example.py\n@@\n-value = 1\n+value = 2\n*** End of File\n"))
+    .toEqual({ ok: true, content: "value = 1\nseparator\nvalue = 2\n" })
+})
+
+test("payload trailing spaces survive framing", () => {
+  expect(applyUpdatePatch("old  \n", "*** Update File: example.txt\n@@\n-old  \n+new  \n"))
+    .toEqual({ ok: true, content: "new  \n" })
+})
+
+test("an absent explicit editor refuses replay", () => {
+  const previous = process.env.AGENT_SESSIONS_PATCH_EDITOR
+  delete process.env.AGENT_SESSIONS_PATCH_EDITOR
+  try {
+    expect(applyUpdatePatch("old\n", "*** Update File: example.txt\n@@\n-old\n+new\n").ok).toBe(false)
+  } finally {
+    if (previous !== undefined) process.env.AGENT_SESSIONS_PATCH_EDITOR = previous
+  }
+})
+
+test("an injected extra operation refuses replay", () => {
+  expect(applyUpdatePatch("old\n", "*** Update File: example.txt\n*** Delete File: other.txt\n@@\n-old\n+new\n").ok)
+    .toBe(false)
+})
