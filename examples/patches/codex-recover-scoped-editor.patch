@@ -0,0 +1,46 @@
+import { test, expect } from "bun:test"
+import { reconstruct, filterRecoveryResult } from "../src/recover.ts"
+const thread = { id: "synthetic-scope", rolloutPath: "/tmp/synthetic-scope.jsonl", cwd: "/workspace/example", title: "synthetic", source: "fixture", archived: false, updatedAt: 1, cliVersion: null, gitBranch: null, gitSha: null }
+const record = (lineNumber: number, payload: unknown) => ({ rolloutPath: thread.rolloutPath, lineNumber, timestamp: null, type: "response_item", payload })
+const create = ["a.txt", "b.txt", "c.txt"].flatMap((path, index) => [
+  record(index * 2 + 1, { type: "custom_tool_call", name: "apply_patch", call_id: path, input: `*** Begin Patch\n*** Add File: ${path}\n+old\n*** End Patch\n` }),
+  record(index * 2 + 2, { type: "custom_tool_call_output", call_id: path, output: "Exit code: 0\nOutput:\nSuccess." })
+])
+const select = (later: Array<ReturnType<typeof record>>, path="a.txt") => filterRecoveryResult(
+  reconstruct([thread], [{ thread, records: [...create, ...later], parseErrors: [] }]), [`/workspace/example/${path}`])
+const command = (cmd: string) => [
+  record(7, { type: "function_call", name: "exec_command", call_id: "later", arguments: JSON.stringify({ cmd, workdir: thread.cwd }) }),
+  record(8, { type: "function_call_output", call_id: "later", output: "Exit code: 0\nOutput:\n" })
+]
+
+test("move source keeps structured mutation evidence and historical snapshot warning", () => {
+  const result=select(command("mv a.txt b.txt"))
+  expect(result.files[0]?.content).toBe("old\n")
+  expect(result.files[0]?.warnings.length).toBeGreaterThan(0)
+  expect(result.unresolvedMutations).toHaveLength(1)
+  expect(result.unresolvedMutations[0]?.affectedPaths).toEqual(["/workspace/example/b.txt", "/workspace/example/a.txt"])
+})
+
+test("copy source remains outside destination-only mutation uncertainty", () => {
+  const result=select(command("cp a.txt b.txt"))
+  expect(result.files[0]?.warnings).toEqual([])
+  expect(result.unresolvedMutations).toHaveLength(0)
+})
+
+test("path filter retains a missing completion without changing old content", () => {
+  const result=select([record(7, { type: "custom_tool_call", name: "apply_patch", call_id: "later", input: "*** Begin Patch\n*** Update File: a.txt\n@@\n-old\n+new\n*** End Patch\n" })])
+  expect(result.files[0]?.content).toBe("old\n")
+  expect(result.unresolvedMutations).toHaveLength(1)
+})
+
+test("known unrelated destination uncertainty stays outside the selected scope", () => {
+  const result=select(command("cp c.txt other.txt"))
+  expect(result.files[0]?.warnings).toEqual([])
+  expect(result.unresolvedMutations).toHaveLength(0)
+})
+
+test("multiple-source move retains unknown-scope evidence for the second source", () => {
+  const result=select(command("mv a.txt b.txt folder"), "b.txt")
+  expect(result.files[0]?.content).toBe("old\n")
+  expect(result.unresolvedMutations.some(item => item.path === "(shell)")).toBe(true)
+})
