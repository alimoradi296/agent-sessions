+++ b/tests/filter-uncertainty.test.ts
@@ -0,0 +1,32 @@
+import { test, expect } from "bun:test"
+import { reconstruct, filterRecoveryResult } from "../src/recover.ts"
+const thread = { id: "synthetic-filter", rolloutPath: "/tmp/synthetic-filter.jsonl", cwd: "/workspace/example", title: "synthetic", source: "fixture", archived: false, updatedAt: 1, cliVersion: null, gitBranch: null, gitSha: null }
+const record = (lineNumber: number, payload: unknown) => ({ rolloutPath: thread.rolloutPath, lineNumber, timestamp: null, type: "response_item", payload })
+const create = [
+ record(1, { type: "custom_tool_call", name: "apply_patch", call_id: "create", input: "*** Begin Patch\n*** Add File: a.txt\n+old\n*** End Patch\n" }),
+ record(2, { type: "custom_tool_call_output", call_id: "create", output: "Exit code: 0\nOutput:\nSuccess." })
+]
+const result = (later: Array<ReturnType<typeof record>>) => reconstruct([thread], [{ thread, records: [...create, ...later], parseErrors: [] }])
+test("selected file retains generic missing-completion evidence and identical historical bytes", () => {
+ const original = result([record(3, { type: "custom_tool_call", name: "apply_patch", call_id: "later", input: "*** Begin Patch\n*** Update File: a.txt\n@@\n-old\n+new\n*** End Patch\n" })])
+ const filtered = filterRecoveryResult(original, ["/workspace/example/a.txt"])
+ expect(filtered.files).toEqual(original.files)
+ expect(filtered.unresolvedMutations).toHaveLength(1)
+ expect(filtered.evidence.some(e => e.callId === "later" && e.status === "unresolved")).toBe(true)
+})
+test("selected file retains generic failed-shell evidence", () => {
+ const original = result([record(3, { type: "function_call", name: "exec_command", call_id: "later", arguments: JSON.stringify({cmd: "python transform.py", workdir: "/workspace/example"}) }), record(4, { type: "function_call_output", call_id: "later", output: "Exit code: 7\nOutput:\n" })])
+ const filtered = filterRecoveryResult(original, ["/workspace/example/a.txt"])
+ expect(filtered.files).toEqual(original.files)
+ expect(filtered.unresolvedMutations).toHaveLength(1)
+})
+test("known unrelated file uncertainty remains outside selected scope", () => {
+ const original = result([
+  record(3, { type: "custom_tool_call", name: "apply_patch", call_id: "later", input: "*** Begin Patch\n*** Update File: b.txt\n@@\n-old\n+new\n*** End Patch\n" }),
+  record(4, { type: "custom_tool_call_output", call_id: "later", output: "Exit code: 0\nOutput:\nSuccess." })
+ ])
+ const filtered = filterRecoveryResult(original, ["/workspace/example/a.txt"])
+ expect(filtered.files).toHaveLength(1)
+ expect(filtered.files[0]?.content).toBe("old\n")
+ expect(filtered.unresolvedMutations).toHaveLength(0)
+})
